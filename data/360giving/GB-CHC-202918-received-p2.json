tnlcomfund-0030116094","data":{"id":"360G-tnlcomfund-0030116094","title":"Building Livelihoods & Strengthening Communities","currency":"GBP","awardDate":"2012-03-21T00:00:00+00:00","description":"The project will provide intensive support to 527 participants plus less intensive support to 345 participants. The project will engage with 70 community groups to provide livelihoods support. A full evaluation will take place and be disseminated to policy makers at ten events. The grant, over three years, will contribute to the employment of thirteen staff, and pay for training, activities, evaluation, publicity and running costs.","dateModified":"2016-05-11T14:50:00Z","plannedDates":[{"duration":48,"startDate":"2012-08-31T00:00:00+00:00"}],"amountAwarded":842775,"grantProgramme":[{"code":"PPF1","title":"People and Places"}],"amountAppliedFor":842775,"fundingOrganization":[{"id":"GB-GOR-PB188","name":"The National Lottery Community Fund"}],"recipientOrganization":[{"id":"GB-CHC-202918","name":"Oxfam","location":[{"name":"Cowley","geoCode":"E05006549"},{"name":"Oxford","geoCode":"E07000178"}],"charityNumber":"202918","companyNumber":"612172","organisationType":"Charity : Registered Charity"}]},"publisher":{"self":"https://api.threesixtygiving.org/api/v1/org/GB-GOR-PB188/","org_id":"GB-GOR-PB188"},"data_license":{"url":"http://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/","name":"Open Government Licence 3.0 (United Kingdom)"}}]}
{"results":[{"grant_id":"360G-cabinetoffice-G2-GA-202112637679-20-21","data":{"id":"360G-cabinetoffice-G2-GA-202112637679-20-21","title":"Arusha Rural Water Supply - WaterAid (sustaining rural water and sanitation services through innovative technologies, behaviour centred interventions and Management Models in five villages of Arusha district Council)","currency":"GBP","awardDate":"2017-04-01","Award type":"Organisation","description":"To deliver more and higher quality services and better health now and in the long term. It will prevent over 2,800 women dying in pregnancy or childbirth, safely deliver 69,500 babies, provide 1 million users with modern family planning, screen over 900,000 women for cervical cancer, and provide 1.7 million young children and 300,000 pregnant women with essential nutritional care.","dateModified":"2021-12-09T00:00:00Z","fromOpenCall":"No","amountAwarded":690000,"grantProgramme":[{"code":"G2-SCH-2021-12-9686","title":"Support to Rural Water Supply, Sanitation & Hygiene in Tanzania"}],"Allocation Method":"General grants - Un-competed","fundingOrganization":[{"id":"GB-GOR-D1315","name":"Foreign, Commonwealth & Development Office"}],"Number of recipients":"1","recipientOrganization":[{"id":"GB-COH-01787329","name":"WATERAID","postalCode":"E145NN","charityNumber":"288701","companyNumber":"01787329","streetAddress":"6TH FLOOR 20 CANADA SQUARE","addressCountry":"United Kingdom","addressLocality":"LONDON"}]},"publisher":{"self":"https://api.threesixtygiving.org/api/v1/org/GB-GOR-D2/","org_id":"GB-GOR-D2"},"data_license":{"url":"http://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/","name":"Open Government Licence 3.0 (United Kingdom)"}},{"grant_id":"360G-cabinetoffice-GA-013967","data":{"id":"360G-cabinetoffice-GA-013967","title":"A hidden crisis: unravelling current failures for future success in rural groundwater supply","currency":"GBP","awardDate":"2015-05-01T00:00:00+00:00","description":"Full Grant details (including summaries) can be found on the Gateway to Research website: http://gtr.rcuk.ac.uk/projects?ref=NE/M007960/1","dateModified":"2017-08-03T00:00:00+00:00","fromOpenCall":"Yes","amountAwarded":72899,"grantProgramme":[{"code":"SCH-000003295","title":"RCUK - Scheme 4 years 15/16"}],"Allocation Method":"General Grants - Competed","fundingOrganization":[{"id":"GB-GOR-D1198","name":"Department for Business, Energy and Industrial Strategy"}],"recipientOrganization":[{"id":"GB-CHC-288701","name":"WaterAid UK","postalCode":"SE11 5JD","charityNumber":"288701","streetAddress":"47-49 Durham Street","addressCountry":"United Kingdom","addressLocality":"London"}]},"publisher":{"self":"https://api.threesixtygiving.org/api/v1/org/GB-GOR-D2/","org_id":"GB-GOR-D2"},"data_license":{"url":"http://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/","name":"Open Government Licence 3.0 (United Kingdom)"}},{"grant_id":"360G-CR-730896","data":{"id":"360G-CR-730896","title":"Building entrepreneurship for water, liquid, and solid waste management in slums of Dar es Salaam","currency":"GBP","awardDate":"2015-05-27T00:00:00+00:00","description":"The majority of Dar es Salaam’s population live in slums with inadequate access to water, toilets and garbage disposal services. As a result many people are vulnerable to diseases such as cholera. Temeke Municipality wants to improve these conditions and has asked WaterAid to support existing small businesses to provide some of the required services. Enterprises will be helped to develop business skills and to use improved techniques so that they can provide water, empty pit latrines safely and operate basic garbage collection services on a profitable basis. New garbage collection points and facilities for safely processing the sludge from latrines will make conditions safer for everyone.","dateModified":"2022-02-24T00:00:00+00:00","plannedDates":[{"endDate":"2019-07-08T00:00:00+00:00","duration":36,"startDate":"2015-10-01T00:00:00+00:00"}